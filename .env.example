# ==============================================================================
# DocAnalyst Environment Configuration
# Copy this file to .env and replace the values with your actual credentials.
# ==============================================================================

# Google Gemini API Key (Required for document analysis, summarization, and RAG Q&A)
# Obtain from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# JWT Secret Key (Optional in development, recommended in production)
# Secret key used for signing JSON Web Tokens for user session authentication.
# Generate a strong key with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_key_here
